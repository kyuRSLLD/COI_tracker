{
  "name": "coi-tracker-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "esbuild src/index.ts src/seed.ts --platform=node --format=esm --packages=external --bundle --outdir=dist",
    "start": "node dist/index.js",
    "seed": "node --experimental-strip-types src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "test": "node --experimental-strip-types src/test-suite.ts",
    "test:carrier": "node --experimental-strip-types --test test/carrier-connect.test.ts",
    "test:invitations": "node --experimental-strip-types --test test/staged-invitations.test.ts test/staged-sub-qr.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.3"
  }
}

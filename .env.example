# ============================================================
# COI Shield — Environment Configuration (Railway + AWS S3)
# ============================================================
# Copy this file to .env and fill in your values.
# On Railway, set these variables in your service's "Variables" tab.

PORT=5001
NODE_ENV=development

# ------------------------------------------------------------
# DATABASE (PostgreSQL on Railway)
# ------------------------------------------------------------
# Railway provides DATABASE_URL automatically when you attach
# a PostgreSQL plugin to your project.
# Leave blank for local development to use the built-in SQLite database.
DATABASE_URL=postgresql://postgres:password@host:port/database

# ------------------------------------------------------------
# FILE STORAGE (Amazon AWS S3)
# ------------------------------------------------------------
# Used for storing uploaded COI certificate PDFs and images.
# If AWS credentials are blank, files are stored on local disk (./uploads),
# so everything works out of the box during development.
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-coi-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional: custom endpoint for S3-compatible storage (Cloudflare R2, MinIO, etc.)
# AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ------------------------------------------------------------
# APPLICATION SECURITY
# ------------------------------------------------------------
JWT_SECRET=change-me-to-a-very-long-random-string-in-production
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# EMAIL (Optional — SMTP for reminder & request emails)
# ------------------------------------------------------------
# If blank, the app runs in simulation mode (all sent emails are logged
# and viewable right inside the GC dashboard "Email Log" panel).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM="COI Shield <no-reply@yourcompany.com>"
